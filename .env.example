# =============================================================================
# Variables de entorno por defecto · Banco de Preguntas Saber Pro (Taller 2)
#
# Copia este archivo a `.env` (que NO se versiona) antes de levantar Docker:
#   cp .env.example .env
#
# Nombres y valores exactos de CONTRATOS.md §9.2 (valores "en Docker").
# Son credenciales de desarrollo local, no secretos reales.
# =============================================================================

# --- Credenciales de RabbitMQ (contenedor `rabbitmq` y servicios editorial/evaluacion)
RABBITMQ_USUARIO=banco
RABBITMQ_CLAVE=banco123

# --- servicio-editorial (P1)
EDITORIAL_PUERTO_HTTP=8081
EDITORIAL_BD_URL=jdbc:postgresql://bd-editorial:5432/editorial
# También son el usuario y la clave con los que se crea el contenedor `bd-editorial`.
EDITORIAL_BD_USUARIO=editorial
EDITORIAL_BD_CLAVE=editorial
CATALOGO_GRPC_HOST=servicio-catalogo
CATALOGO_GRPC_PUERTO=50051

# --- servicio-catalogo (P3)
CATALOGO_PUERTO_HTTP=8082
CATALOGO_PUERTO_GRPC=50051
CATALOGO_BD_URL=postgresql+psycopg://catalogo:catalogo@bd-catalogo:5432/catalogo
# Usuario y clave con los que se crea el contenedor `bd-catalogo`.
# No los lee el servicio (usa CATALOGO_BD_URL): deben coincidir con los de esa URL.
BD_CATALOGO_USUARIO=catalogo
BD_CATALOGO_CLAVE=catalogo

# --- servicio-evaluacion (P2)
EVALUACION_PUERTO_HTTP=8083
EVALUACION_MONGO_URL=mongodb://bd-evaluacion:27017/evaluacion

# --- RabbitMQ: conexión (servicio-editorial y servicio-evaluacion)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PUERTO=5672

# --- Todos los contenedores
# docker-compose.yml fija TZ=UTC en todos los contenedores (§4 y §9.2).
TZ=UTC
